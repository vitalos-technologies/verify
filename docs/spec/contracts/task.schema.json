{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vitalos.example/task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "milestone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "ready",
        "in_progress",
        "blocked",
        "review",
        "verified",
        "merged",
        "abandoned"
      ]
    },
    "owner_role": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "spec": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "milestone",
    "title",
    "status",
    "owner_role",
    "depends_on",
    "spec",
    "description",
    "acceptance",
    "evidence_required",
    "commit",
    "reviewer"
  ]
}