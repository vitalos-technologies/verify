 "components": {
  "securitySchemes": {
   "ApiKey": {
    "type": "http",
    "scheme": "bearer",
    "description": "Tenant-scoped API credential"
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "request_id": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "request_id"
    ]
   },
   "CreateSession": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "external_reference": {
      "type": "string",
      "maxLength": 128
     },
     "policy_id": {
      "type": "string"
     },
     "policy_version": {
      "type": "integer",
      "minimum": 1
     },
     "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
     },
     "document_type": {
      "type": "string"
     }
    },
    "required": [
     "external_reference",
     "policy_id",
     "policy_version",
     "country",
     "document_type"
    ]
   },
   "Check": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "type": {
      "type": "string",
      "enum": [
       "government_id",
       "face_match",
       "liveness",
       "email",
       "phone",
       "document",
       "database",
       "nfc",
       "age",
       "digital_id"
      ]
     },
     "result": {
      "type": "string",
      "enum": [
       "pass",
       "fail",
       "inconclusive",
       "error",
       "not_run"
      ]
     },
     "reasons": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "provider_version": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "type",
     "result",
     "reasons"
    ]
   },
   "Session": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "external_reference": {
      "type": "string"
     },
     "state": {
      "type": "string",
      "enum": [
       "created",
       "in_progress",
       "processing",
       "approved",
       "declined",
       "review_required",
       "action_required",
       "expired",
       "cancelled",
       "error"
      ]
     },
     "revision": {
      "type": "integer",
      "minimum": 1
     },
     "policy_id": {
      "type": "string"
     },
     "policy_version": {
      "type": "integer",
      "minimum": 1
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "expires_at": {
      "type": "string",
      "format": "date-time"
     },
     "checks": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Check"
      }
     },
     "decision": {
      "oneOf": [
       {
        "$ref": "#/components/schemas/DecisionSummary"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "external_reference",
     "state",
     "revision",
     "policy_id",
     "policy_version",
     "created_at",
     "expires_at",
     "checks"
    ]
   },
   "CreateSessionResponse": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
