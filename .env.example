# Local development only. Copy to .env (gitignored). Never put real credentials in this file.
VV_ENV=development
VV_OWNER_DSN=postgresql://vv_owner:vv_owner_local@localhost:5432/vv_dev
VV_APP_DSN=postgresql://vv_app:vv_app_local@localhost:5432/vv_dev
VV_WORKER_DSN=postgresql://vv_worker:vv_worker_local@localhost:5432/vv_dev
VV_HOSTED_BASE_URL=http://localhost:8000
# Outside development/test/ci these MUST be set (32+ random bytes, urlsafe base64):
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# VV_DATA_KEY=
# VV_HMAC_PEPPER=
# VV_DUMMY_PROVIDER_SECRET=
# Console sign-in (owner decision): Google + email magic link, then authenticator app (TOTP).
# Google: create an OAuth client (Web) in Google Cloud; redirect URI = <console>/console/oidc/callback
# VV_OIDC_ISSUER=https://accounts.google.com
# VV_OIDC_CLIENT_ID=
# VV_OIDC_CLIENT_SECRET=
# VV_CONSOLE_BASE_URL=http://localhost:3000
# VV_EVIDENCE_DIR=   (dev default: services/api/.evidence-local)
# Magic-link and code emails in staging/production (Amazon SES, eu-west-2, verified sender domain):
# VV_EMAIL_FROM=no-reply@verify.vitalos.co.uk
# VV_EVIDENCE_BUCKET= / VV_EVIDENCE_KMS_KEY_ID= / VV_TOMBSTONE_BUCKET=   (required outside development)
